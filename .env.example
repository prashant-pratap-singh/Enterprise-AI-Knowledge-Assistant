# ==============================================================================
# Enterprise AI Knowledge Assistant - Environment Configuration Template
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Application Core Settings
ENVIRONMENT=development
APP_NAME="Enterprise AI Knowledge Assistant"
DEBUG=true
LOG_LEVEL=INFO
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# Security & Authentication
# Generate a secure 32+ character key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-in-production-to-a-very-secure-random-secret-key-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings (comma-separated list of allowed origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Relational Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=enterprise_knowledge
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_knowledge
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_knowledge

# Vector Database (ChromaDB)
# CHROMA_MODE can be 'local' (embedded disk storage) or 'http' (ChromaDB container / server)
CHROMA_MODE=local
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Google Gemini API & AI Models
# Provide your Google Gemini API key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_FLASH_MODEL=gemini-1.5-flash
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIMENSIONS=768

# Document Storage (local or gcs)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage/documents
GCS_BUCKET_NAME=

# Document Processing & Ingestion
MAX_UPLOAD_SIZE_MB=25
DEFAULT_CHUNK_SIZE_TOKENS=1000
DEFAULT_CHUNK_OVERLAP_TOKENS=150
ALLOWED_MIME_TYPES="application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/csv"

# Retrieval & Multi-Agent Orchestration
RETRIEVAL_TOP_K=8
HYBRID_SEARCH_ALPHA=0.6
RELEVANCE_SCORE_THRESHOLD=0.45
MAX_CONTEXT_TOKENS=4000
MAX_AGENT_RETRIES=2
RERANKING_ENABLED=false

# Cache & Message Broker (Optional / Redis)
REDIS_URL=redis://localhost:6379/0

# Frontend Configuration (for frontend/.env)
VITE_API_BASE_URL=http://localhost:8000
